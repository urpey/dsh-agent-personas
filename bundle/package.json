{
  "name": "dsh-agent-personas",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent persona engine for DeepSeek Harness — three-layer persona profiles, a layered numeric state system, and a URI memory tree under .persona/<name>/",
  "type": "module",
  "license": "MIT",
  "author": "urpey",
  "repository": {
    "type": "git",
    "url": "https://github.com/urpey/dsh-agent-personas.git",
    "directory": "bundle"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "persona",
    "agent",
    "memory"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./runtime": "./lib/equip.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**",
    "prompts/**",
    "templates/**",
    "examples/**",
    "skills/**",
    "locale/*.json",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-commands"]
    }
  }
}
